# ==============================================================================
# Multilingual Voice SyncUp — Environment Configuration
# Track 2: Voice AI at Work: Beyond the Call Center
# Agora Conversational AI Engine + Murf.ai Falcon 2.1
# ==============================================================================

# Agora Credentials
# Found in Agora Console: https://console.agora.io
AGORA_APP_ID=your_agora_app_id_here
AGORA_APP_CERTIFICATE=your_agora_app_certificate_here
AGORA_CUSTOMER_KEY=your_agora_customer_id_here
AGORA_CUSTOMER_SECRET=your_agora_customer_secret_here

# Murf.ai Credentials
# Model: Falcon 2.1 Streaming TTS (<100ms TTFA)
# Endpoint: wss://in.api.murf.ai/v1/speech/stream-input
MURF_API_KEY=your_murf_api_key_here
MURF_DEFAULT_VOICE_ID=hi-IN-kabir

# OpenAI / LLM Credentials (Used by Agora Conversational AI Orchestrator)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o-mini

# Backend Service Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Public Frontend API URL (Used by Next.js client)
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
